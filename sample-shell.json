{
  "version": 1,
  "bar": {
    "id": "omarchy.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" }
      ],
      "center": [
        { "id": "omarchy.clock", "format": "HH:mm" }
      ],
      "right": [
        {
          "id": "adi.ticking",
          "customTitle": "NEW HORIZON",
          "targetTimestamp": "2026-10-25",
          "startTimestamp": "2026-01-01",
          "showMilliseconds": true,
          "showProgress": true,
          "showPanelBadge": true,
          "showQuoteBar": true,
          "accentColor": "#00E599"
        },
        { "id": "omarchy.tailscale" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.power" }
      ]
    }
  }
}
